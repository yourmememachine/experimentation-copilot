# Copy to .env and fill in your own Flagsmith values.
FLAGSMITH_API_URL=https://app.flagsmith.com/api/v1/
FLAGSMITH_API_TOKEN=
FLAGSMITH_PROJECT_ID=
FLAGSMITH_ENVIRONMENT_ID=
# Demo mode runs against the built-in sample flag store, no Flagsmith
# account needed. With a token set, live mode requires this to be
# explicitly 0 or false; anything else keeps the demo store.
FLAGSMITH_DEMO_MODE=true
PORT=8077
